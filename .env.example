TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

DEEPGRAM_API_KEY=your_deepgram_api_key

# --- LLM provider: "groq" (free forever) ya "anthropic" (Claude, paid) ---
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- TTS provider: "deepgram" (same $200 free credit) ya "elevenlabs" ---
TTS_PROVIDER=deepgram
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# System Prompt for the LLM
SYSTEM_PROMPT="You are a helpful assistant for a healthcare clinic. Answer briefly and naturally, in 1-2 short sentences."

# Outbound greeting (spoken verbatim when a human answers an outbound call)
OUTBOUND_GREETING="Hi, this is calling from the healthcare clinic about your upcoming appointment. Are you available to speak?"

# Left on answering machines when AMD detects one
VOICEMAIL_MESSAGE="Hi, this is a message from the healthcare clinic. Please call us back at your earliest convenience. Thank you!"

# Database password for SQLCipher encryption at rest (required)
DB_PASSWORD=change_me_to_a_long_random_password

# Public URL of this server (e.g., ngrok URL) for Twilio callbacks (no trailing slash)
BASE_URL=https://your-ngrok-url.ngrok-free.app

# Key required in X-API-Key header for /call, /call/batch, /call/csv endpoints.
# If empty, those endpoints are disabled entirely.
ADMIN_API_KEY=

# Outbound calling window (local hours at callee), TCPA guidance: 9 AM - 6 PM
CALLING_HOUR_START=9
CALLING_HOUR_END=18

# Barge-in guard: minimum chars of FINAL transcript to interrupt the agent
MIN_INTERRUPT_CHARS=2

LOG_LEVEL=INFO
